[Unit]
Description=Stub camera virtuelle T1 (images noires, camera eteinte)

[Service]
ExecStart=/usr/bin/gst-launch-1.0 videotestsrc pattern=black ! video/x-raw,format=YUY2,width=1280,height=720,framerate=30/1 ! v4l2sink device=/dev/video2
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
